{
  "name": "miko",
  "productName": "Miko",
  "version": "1.2.0",
  "description": "Miko — a secure Electron control surface for live realtime character swap.",
  "main": "main.js",
  "author": "Miko",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc --noEmit",
    "check": "node --check main.js && node --check preload.js && node --check app.js && node --check lib/billing-policy.js && node --check lib/reference-policy.js && node --check lib/session-presets.js && node --check lib/network-check.js && node --check lib/obs-relay.js && node --check lib/decart-api.js",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --universal",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@decartai/sdk": "0.2.0",
    "@fal-ai/client": "1.10.1"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.tifediceeyy.miko",
    "productName": "Miko",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "lib/billing-policy.js",
      "lib/reference-policy.js",
      "lib/session-presets.js",
      "lib/network-check.js",
      "lib/obs-relay.js",
      "lib/decart-api.js",
      "dist/**/*",
      "README.md",
      "PRODUCT.md"
    ],
    "mac": {
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Miko uses the camera for live preview and the realtime swap session."
      }
    },
    "win": {
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    }
  }
}
